		<string>This app needs camera access for virtual makeup try-on and AR lipstick effects.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>This app may need microphone access for video recording features.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>This app needs photo library access to save and load makeup looks.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>This app saves your hair style try-on photos to your photo library.</string>
		<!-- Google Sign-In required URL scheme -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.694949898753-5ggkst3hduobmgvmpbdn86ibn8vat0kh</string>
				</array>
			</dict>
		</array>
