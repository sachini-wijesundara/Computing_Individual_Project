# COMMIT THIS FILE in submissions — do NOT commit `.env` (real keys stay private).
#
# Local setup: copy to `.env` in this folder (same directory as pubspec.yaml).
# `.env` is gitignored. `ios_quick_run.sh` loads `.env` and passes values into Flutter.
#
#   cp .env.example .env
#   # edit .env with your keys, then ./ios_quick_run.sh

# Google AI Studio (Gemini): chat assistant + skin/hair photo analysis
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter: AI Hair Style Matcher (required for Style Match screen)
# https://openrouter.ai/keys — create a key; must be the full sk-or-v1-… string.
# One line, NO quotes, NO "Bearer " prefix. After changing .env, run ./ios_quick_run.sh again (not hot reload).
OPENROUTER_API_KEY=
# Optional — default below matches AppSecrets.openRouterModel
# OPENROUTER_MODEL=openai/gpt-4o-mini
