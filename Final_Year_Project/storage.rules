rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'lavougevistaofficial@gmail.com';
    }

    // Product images are public readable; only admin can upload/update/delete.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
