# Copy to `.env` in this folder (same directory as pubspec.yaml) and fill in your key.
# `.env` is gitignored. `ios_quick_run.sh` loads `.env` automatically.
#
#   cp env.example .env
#   # edit .env with your real keys (never commit .env)

# Gemini — AI Beauty Assistant + skin/hair vision: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — Hair Style Matcher: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
# Optional model override (default: google/gemini-2.0-flash-001 in app_secrets.dart)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# EmailJS (order confirmation) — loaded by ios_quick_run.sh
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_ACCESS_TOKEN=your_emailjs_access_token_here

# Stripe TEST mode: Dashboard → turn ON “Test mode” (top right). Use pk_test_ + sk_test_ only.
# Publishable key goes here (full string). Secret key → Firebase only (deploy_stripe_functions.sh secret).
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_PAYMENT_INTENT_URL=https://your-cloud-function-url/createpaymentintent

# Flutter web admin (web_quick_run.sh) — Web app ID from Firebase Console
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_WEB_APP_ID=your_firebase_web_app_id_here
# Comma-separated; must match a Firebase Auth user you can sign in with:
ADMIN_PANEL_EMAILS=admin@example.com
# Optional — default in app is 123456 if unset. Must match Firebase Auth password for that user.
ADMIN_PANEL_PASSWORD=your_admin_password_here
